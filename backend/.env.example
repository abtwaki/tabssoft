# Copy to .env and fill in. Never commit .env.

# --- Core ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tabssoftglobal.com,www.tabssoftglobal.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://tabssoftglobal.com,https://www.tabssoftglobal.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite default if unset) ---
# DATABASE_URL=postgres://tabssoft:password@127.0.0.1:5432/tabssoft_db
# DATABASE_URL=mysql://tabssoft:password@127.0.0.1:3306/tabssoft_db

# --- AI provider (pick one) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=2048
AI_THROTTLE_RATE=30/hour

# --- Paystack (test keys) ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_CURRENCY=NGN

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@tabssoftglobal.com
CONTACT_EMAIL=info@tabssoftglobal.com

# --- Security ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
